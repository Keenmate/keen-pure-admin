<!DOCTYPE html>
<html lang="en" {PureAdmin.Config.root_html_attrs()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Pure Admin Demo" suffix=" · PureAdmin">
      {assigns[:page_title]}
    </.live_title>
    <%!-- Theme CSS: build the <link> in the head with the correct theme href so
         it is render-blocking BEFORE first paint (no post-paint href swap, which
         is non-blocking and flashes unstyled content). Reads ?theme= query param
         (persisting it) → localStorage → default. Mirrors svelte's app.html. --%>
    <script>
      (function() {
        var m = location.search.match(/[?&]theme=([^&]+)/);
        if (m) { try { localStorage.setItem("theme", decodeURIComponent(m[1])); } catch (e) {} }
        var t;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (!t) t = "audi";
        var link = document.createElement("link");
        link.id = "pa-theme-css";
        link.rel = "stylesheet";
        link.href = "/themes/" + t + "/dist/" + t + ".css";
        document.currentScript.parentNode.insertBefore(link, document.currentScript);
      })();
    </script>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/core@1.6.9"></script>
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/dom@1.6.13"></script>
    <%!-- Chart.js — used only by the KPI demo pages to show that the chart slot
         is library-agnostic (any chart library drops into `pa-kpi-*__chart`). --%>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://stats.keenmate.services/js/pa-UDkvnx57n2uUCqkgIDS3H.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <%!-- Critical CSS: Page loader (inline to prevent FOUC) --%>
    <style>
      .page-loader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--page-loader-bg, rgba(26, 26, 26, 0.95));
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 99999;
        transition: opacity 0.15s ease, visibility 0.15s ease;
      }
      .page-loader.loaded {
        opacity: 0;
        visibility: hidden;
      }
      .page-loader__spinner {
        width: 50px;
        height: 50px;
        border: 4px solid var(--page-loader-spinner-border, #333);
        border-top-color: var(--page-loader-spinner-accent, #0066cc);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>
  </head>
  <body>
    <%!-- Page Loader: Shows while fonts/CSS/LiveView load --%>
    <div class="page-loader" id="pageLoader">
      <div class="page-loader__spinner"></div>
    </div>
    <script>
      (function() {
        var t0 = performance.now();
        var _debug = (localStorage.getItem('pa-debug') === 'true');
        var log = function(msg) { if (_debug) console.debug('%c[PA:LOADER] ' + msg + ' @ ' + Math.round(performance.now() - t0) + 'ms', 'color: #0ea5e9; font-weight: bold;'); };
        var loader = document.getElementById('pageLoader');
        if (!loader) { window.__pageLoaderReady = function(){}; return; }
        var fontsReady = false;
        var appReady = false;
        var cssReady = false;
        var hidden = false;

        log('init');

        var MIN_DISPLAY_MS = 400; // Don't flash the loader — show it properly or not at all

        function hideLoader() {
          if (!fontsReady || !appReady || !cssReady || hidden) return;
          hidden = true;
          var elapsed = performance.now() - t0;
          var delay = Math.max(0, MIN_DISPLAY_MS - elapsed);
          log('ALL READY — hiding in ' + Math.round(delay) + 'ms (elapsed=' + Math.round(elapsed) + 'ms)');
          setTimeout(function() {
            requestAnimationFrame(function() {
              loader.classList.add('loaded');
              setTimeout(function() { loader.remove(); log('loader removed from DOM'); }, 150);
            });
          }, delay);
        }

        // Wait for fonts
        if (document.fonts && document.fonts.ready) {
          Promise.race([
            document.fonts.ready,
            new Promise(function(resolve) { setTimeout(resolve, 2000); })
          ]).then(function() {
            fontsReady = true;
            log('fonts ready');
            hideLoader();
          });
        } else {
          window.addEventListener('load', function() {
            fontsReady = true;
            log('fonts ready (load event fallback)');
            hideLoader();
          });
        }

        // Wait for theme CSS to actually load
        var themeLink = document.getElementById('pa-theme-css');
        if (themeLink) {
          if (themeLink.sheet) {
            cssReady = true;
            log('theme CSS already loaded');
          } else {
            themeLink.addEventListener('load', function() {
              cssReady = true;
              log('theme CSS loaded: ' + themeLink.href);
              hideLoader();
            });
            themeLink.addEventListener('error', function() {
              cssReady = true;
              log('theme CSS failed to load, continuing');
              hideLoader();
            });
            // Fallback if link load event doesn't fire
            setTimeout(function() {
              if (!cssReady) {
                cssReady = true;
                log('theme CSS timeout, continuing');
                hideLoader();
              }
            }, 2000);
          }
        } else {
          cssReady = true;
          log('no theme CSS link found');
        }

        // Wait for LiveView connection — fired by app.js after liveSocket.connect()
        window.__pageLoaderReady = function() {
          appReady = true;
          log('LiveView connected');
          hideLoader();
        };

        // Log key page lifecycle events
        document.addEventListener('DOMContentLoaded', function() { log('DOMContentLoaded'); });
        window.addEventListener('load', function() { log('window.load'); });

        // Safety timeout — never block longer than 4s
        setTimeout(function() {
          if (!hidden) {
            log('SAFETY TIMEOUT — forcing hide (fonts=' + fontsReady + ', app=' + appReady + ', css=' + cssReady + ')');
            fontsReady = true;
            appReady = true;
            cssReady = true;
            hideLoader();
          }
        }, 4000);
      })();
    </script>
    <.page_context />
    <.fouc_prevention_script />
    <%!-- Theme <link> is now built render-blocking in the <head> (see above);
         no post-paint href swap, which caused the flash of unstyled content. --%>
    {@inner_content}
  </body>
</html>
