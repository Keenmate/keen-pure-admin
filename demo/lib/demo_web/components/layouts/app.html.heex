<style>
  /* Inline Lucide sidebar icons inherit link colour (stroke=currentColor); sized a
     touch under the 2.4rem icon box so the stroke weight reads cleanly. Mirrors
     pure-admin's demo sidebar. */
  .pc-sidebar__icon svg { width: 1.7rem; height: 1.7rem; }
  /* Masked glyphs (e.g. the search trigger's .pa-icon--search) match the inline
     Lucide SVG size so the search row aligns with the link icons. */
  .pc-sidebar__icon .pa-icon { --pa-icon-size: 1.7rem; }
  /* Profile-panel nav + favorites Lucide SVGs — sized to match pure-admin's demo. */
  .pa-profile-panel__nav-icon svg,
  .pa-profile-panel__favorite-icon svg { width: 1.7rem; height: 1.7rem; }
  /* Locale switch in the navbar end slot — demo-only chrome. */
  .pa-navbar__language { display: inline-flex; gap: 0.2rem; align-items: center; margin-inline: 0.4rem; }
  .pa-navbar__language-option {
    padding: 0.2rem 0.6rem; border-radius: var(--pc-border-radius, 0.4rem);
    font-size: 1.2rem; font-weight: 600; line-height: 1.6;
    color: var(--pc-navbar-color, inherit); opacity: 0.6; text-decoration: none;
  }
  .pa-navbar__language-option:hover { opacity: 1; }
  .pa-navbar__language-option--active {
    opacity: 1; background: var(--pc-navbar-active-bg, rgba(255,255,255,0.12));
  }
</style>
<.layout>
  <.navbar>
    <:burger><.navbar_burger /></:burger>
    <:start>
      <%!-- rc14 app-identity block; the wordmark degrades wordmark → monogram
            (fit_slot steps) and the version tag drops first (fit_slot hide). --%>
      <.app_header>
        <h1>
          <.fit_slot strategy="steps" priority={30} class="pc-app-header__name">
            <.fit_step index={0}>KeenPureAdmin</.fit_step>
            <.fit_step index={1}>KPA</.fit_step>
          </.fit_slot><.fit_slot strategy="hide" priority={10} class="pc-app-header__version">v2.9.0-rc14</.fit_slot>
        </h1>
      </.app_header>
      <%!-- collapse="sidebar" hands this menu to the Fit engine's nav path: as the
            header narrows, lowest-priority items fold into the sidebar under a "Menu"
            heading, restoring as it widens. Dashboard is pinned (priority 10); the
            active item auto-pins. Mirrors pure-admin's demo navbar. --%>
      <.nav_menu collapse="sidebar" collapse_label={gettext("Menu")}>
        <.nav_item href="/" priority={10} icon="📊">{gettext("Dashboard")}</.nav_item>
        <.nav_item href="/buttons" has_dropdown icon="🧩">
          {gettext("Components")}
          <:dropdown>
            <.nav_dropdown>
              <.nav_item href="/buttons">{gettext("Buttons")}</.nav_item>
              <.nav_item href="/surfaces/cards">{gettext("Cards")}</.nav_item>
              <.nav_item href="/surfaces/tabs">{gettext("Tabs")}</.nav_item>
              <.nav_item has_dropdown>
                {gettext("More")} ›
                <:dropdown>
                  <.nav_dropdown is_level2>
                    <.nav_item href="/interactive/badges">{gettext("Badges")}</.nav_item>
                    <.nav_item href="/surfaces/modals">{gettext("Modals")}</.nav_item>
                    <.nav_item href="/surfaces/modal-dialogs">{gettext("Modal Dialogs")}</.nav_item>
                    <.nav_item href="/buttons/popconfirm">{gettext("Popconfirm")}</.nav_item>
                    <.nav_item href="/interactive/command-palette">{gettext("Command Palette")}</.nav_item>
                    <.nav_item href="/data-display">{gettext("Data Display")}</.nav_item>
                    <.nav_item href="/data-display/data-display-2">{gettext("Data Display 2")}</.nav_item>
                    <.nav_item href="/data-viz">{gettext("Data Visualization")}</.nav_item>
                    <.nav_item href="/surfaces/detail-panel">{gettext("Detail Panel")}</.nav_item>
                    <.nav_item href="/feedback/loaders">{gettext("Loaders")}</.nav_item>
                    <.nav_item href="/data-display/lists">{gettext("Lists")}</.nav_item>
                    <.nav_item href="/data-display/code">{gettext("Code")}</.nav_item>
                    <.nav_item href="/feedback/callouts">{gettext("Callouts")}</.nav_item>
                    <.nav_item href="/design/typography">{gettext("Typography")}</.nav_item>
                    <.nav_item href="/data-display/stats">{gettext("Stats")}</.nav_item>
                  </.nav_dropdown>
                </:dropdown>
              </.nav_item>
            </.nav_dropdown>
          </:dropdown>
        </.nav_item>
        <.nav_item href="/forms" icon="📝">{gettext("Forms")}</.nav_item>
      </.nav_menu>
    </:start>
    <:center>
      <.page_header>
        <h2>{assigns[:page_title] || gettext("Dashboard")}</h2>
      </.page_header>
      <%!-- rc12 search entry point A — inline live field. Hidden until chosen in
            Settings → Search Box; it takes the CENTRE slot, swapping with the title
            (settings-panel JS hides .pc-page-header and shows .pc-navbar-search--field),
            matching pure-admin's navbar. --%>
      <.navbar_search_field
        id="navbarSearchInline"
        is_hidden
        placeholder={gettext("Search products, orders, users…")}
        phx-hook="NavbarSearchDemo"
      />
    </:center>
    <:end_>
      <.nav_menu>
        <.nav_item href="/feedback/alerts">{gettext("Alerts")}</.nav_item>
        <.nav_item href="/tables/standard">{gettext("Tables")}</.nav_item>
      </.nav_menu>
      <%!-- rc12 search entry point B — compact trigger that opens the palette
            (fullscreen sheet on phones). Hidden until chosen in Settings. --%>
      <.navbar_search id="navbarSearchTrigger" is_hidden phx-click={show_command_palette()} />
      <%!-- rc15 search entry point D — type-and-go: a real input in a <form> whose
            native GET submit navigates to /search on Enter. Hidden until chosen. --%>
      <.navbar_search_input id="navbarSearchGo" is_hidden action="/search" placeholder={gettext("Search…")} />
      <.notifications count={3}>
        <.notification_item variant="primary" icon="fa-solid fa-file-pen" is_unread>
          <:title>{gettext("New task assigned")}</:title>
          <:text>{gettext("Review the Q4 report by end of week")}</:text>
          <:time>{gettext("2 minutes ago")}</:time>
        </.notification_item>
        <.notification_item variant="success" icon="fa-solid fa-check" is_unread>
          <:title>{gettext("Build completed")}</:title>
          <:text>{gettext("Production deployment finished successfully")}</:text>
          <:time>{gettext("15 minutes ago")}</:time>
        </.notification_item>
        <.notification_item variant="warning" icon="fa-solid fa-triangle-exclamation">
          <:title>{gettext("Server maintenance")}</:title>
          <:text>{gettext("Scheduled downtime tonight at 11 PM")}</:text>
          <:time>{gettext("1 hour ago")}</:time>
        </.notification_item>
        <:footer_>
          <a href="#">{gettext("View all notifications")}</a>
        </:footer_>
      </.notifications>
      <%!-- Locale switch — plain links to the LocaleController (full round-trip,
            so every LiveView re-mounts at the new locale). --%>
      <div class="pa-navbar__language" role="group" aria-label={gettext("Language")}>
        <a
          :for={lang <- @languages}
          href={~p"/locale/#{lang.code}?return_to=#{@current_path || "/"}"}
          class={[
            "pa-navbar__language-option",
            lang.code == @locale && "pa-navbar__language-option--active"
          ]}
          title={lang.native}
          aria-current={lang.code == @locale && "true"}
        >
          {String.upcase(lang.code)}
        </a>
      </div>
      <.profile_button name="John Doe" phx-click={toggle_profile_panel()} />
    </:end_>
  </.navbar>

  <.layout_inner>
    <.sidebar>
      <%!-- rc12 search entry point C — sidebar trigger that opens the palette. --%>
      <.sidebar_search id="sidebarSearchTrigger" is_hidden phx-click={show_command_palette()} />
      <%!-- rc15 search entry point E — sidebar type-and-go form; Enter (or the submit
            magnifier from the collapsed icon-rail) navigates to /search. --%>
      <.sidebar_search id="sidebarSearchGo" is_hidden action="/search" placeholder={gettext("Search…")} />
      <%!-- Nav IA mirrors pure-admin's demo sidebar (functional groups + inline Lucide
            icons). Items pure-admin lists but keen has no route for are omitted; a few
            keen-only pages are folded into the closest group (marked "keen-only"). --%>

      <%!-- ============================ Docs ============================ --%>
      <.sidebar_item
        label={gettext("Getting Started")}
        icon={sidebar_icon("getting_started")}
        href="/getting-started"
        is_active={@current_path == "/getting-started"}
      />
      <.sidebar_item
        label={gettext("Dashboard")}
        icon={sidebar_icon("dashboard")}
        href="/"
        is_active={@current_path == "/"}
      />
      <.sidebar_item
        label={gettext("Components Overview")}
        icon={sidebar_icon("components_overview")}
        href="/components"
        is_active={@current_path == "/components"}
      />

      <%!-- Phoenix / LiveView (keen-only — no pure-admin equivalent) --%>
      <.sidebar_submenu id="phoenix" label={gettext("Phoenix / LiveView")} icon={sidebar_icon("phoenix")} is_open={String.starts_with?(@current_path, "/phoenix")}>
        <.sidebar_item label={gettext("CoreComponents Migration")} href="/phoenix/core-components" is_active={@current_path == "/phoenix/core-components"} />
        <.sidebar_item label={gettext("Flash Messages")} href="/phoenix/flash" is_active={@current_path == "/phoenix/flash"} />
        <.sidebar_item label={gettext("Form Demo")} href="/phoenix/form-demo" is_active={@current_path == "/phoenix/form-demo"} />
        <.sidebar_item label={gettext("Icon Components")} href="/phoenix/icons" is_active={@current_path == "/phoenix/icons"} />
        <.sidebar_item label={gettext("Command Palette")} href="/phoenix/command-palette" is_active={@current_path == "/phoenix/command-palette"} />
      </.sidebar_submenu>

      <%!-- ============================ Design ========================== --%>
      <.sidebar_submenu id="design" label={gettext("Design")} icon={sidebar_icon("design")} is_open={String.starts_with?(@current_path, "/design")}>
        <.sidebar_item label={gettext("Theme Variables")} icon={sidebar_icon("theme_variables")} href="/design/theme-variables" is_active={@current_path == "/design/theme-variables"} />
        <.sidebar_item label={gettext("Colors")} icon={sidebar_icon("colors")} href="/design/colors" is_active={@current_path == "/design/colors"} />
        <.sidebar_item label={gettext("Icons")} icon={sidebar_icon("icons")} href="/design/icons" is_active={@current_path == "/design/icons"} />
        <.sidebar_item label={gettext("Helpers")} icon={sidebar_icon("helpers")} href="/design/helpers" is_active={@current_path == "/design/helpers"} />
        <.sidebar_item label={gettext("Layouts")} icon={sidebar_icon("layout")} href="/design/layouts" is_active={@current_path == "/design/layouts"} />
        <.sidebar_item label={gettext("Typography")} icon={sidebar_icon("typography")} href="/design/typography" is_active={@current_path == "/design/typography"} />
      </.sidebar_submenu>

      <%!-- ==================== Layout & responsivity =================== --%>
      <.sidebar_submenu id="layout" label={gettext("Layout & responsivity")} icon={sidebar_icon("layout")} is_open={@current_path in ["/layout/sizing", "/layout/grid", "/layout/responsivity", "/layout/fit-to-size", "/layout/container-breakpoint", "/layout/responsive-form"]}>
        <.sidebar_item label={gettext("Sizing & Layout")} icon={sidebar_icon("sizing")} href="/layout/sizing" is_active={@current_path == "/layout/sizing"} />
        <.sidebar_item label={gettext("Grid System")} icon={sidebar_icon("grid")} href="/layout/grid" is_active={@current_path == "/layout/grid"} />
        <.sidebar_item label={gettext("How It Works")} icon={sidebar_icon("responsivity")} href="/layout/responsivity" is_active={@current_path == "/layout/responsivity"} />
        <.sidebar_item label={gettext("Fit to Size")} icon={sidebar_icon("fit_to_size")} href="/layout/fit-to-size" is_active={@current_path == "/layout/fit-to-size"} />
        <.sidebar_item label={gettext("Container Breakpoint")} icon={sidebar_icon("container_breakpoint")} href="/layout/container-breakpoint" is_active={@current_path == "/layout/container-breakpoint"} />
        <.sidebar_item label={gettext("Responsive Form")} icon={sidebar_icon("responsive_form")} href="/layout/responsive-form" is_active={@current_path == "/layout/responsive-form"} />
      </.sidebar_submenu>

      <%!-- ======================= Forms & inputs ====================== --%>
      <.sidebar_submenu id="forms" label={gettext("Forms & inputs")} icon={sidebar_icon("forms_inputs")} is_open={@current_path in ["/forms/inputs", "/forms/validations", "/forms", "/forms/checkbox-lists", "/forms/range-group"]}>
        <.sidebar_item label={gettext("Inputs")} icon={sidebar_icon("inputs")} href="/forms/inputs" is_active={@current_path == "/forms/inputs"} />
        <.sidebar_item label={gettext("Validations")} icon={sidebar_icon("validations")} href="/forms/validations" is_active={@current_path == "/forms/validations"} />
        <.sidebar_item label={gettext("Forms")} icon={sidebar_icon("forms")} href="/forms" is_active={@current_path == "/forms"} />
        <.sidebar_item label={gettext("Checkbox Lists")} icon={sidebar_icon("checkbox_lists")} href="/forms/checkbox-lists" is_active={@current_path == "/forms/checkbox-lists"} />
        <.sidebar_item label={gettext("Range Group")} icon={sidebar_icon("range_group")} href="/forms/range-group" is_active={@current_path == "/forms/range-group"} />
      </.sidebar_submenu>

      <%!-- ===================== Buttons & actions ====================== --%>
      <.sidebar_submenu id="buttons" label={gettext("Buttons & actions")} icon={sidebar_icon("buttons_actions")} is_open={@current_path in ["/buttons", "/buttons/pagers", "/buttons/popconfirm"]}>
        <.sidebar_item label={gettext("Buttons")} icon={sidebar_icon("buttons")} href="/buttons" is_active={@current_path == "/buttons"} />
        <.sidebar_item label={gettext("Pagers")} icon={sidebar_icon("pagers")} href="/buttons/pagers" is_active={@current_path == "/buttons/pagers"} />
        <.sidebar_item label={gettext("Popconfirm")} icon={sidebar_icon("popconfirm")} href="/buttons/popconfirm" is_active={@current_path == "/buttons/popconfirm"} />
      </.sidebar_submenu>

      <%!-- ========================== Surfaces ========================== --%>
      <.sidebar_submenu id="surfaces" label={gettext("Surfaces")} icon={sidebar_icon("surfaces")} is_open={@current_path in ["/surfaces/cards", "/surfaces/tabs", "/surfaces/modals", "/surfaces/modal-dialogs", "/surfaces/detail-panel", "/surfaces/splitter"]}>
        <.sidebar_item label={gettext("Cards")} icon={sidebar_icon("cards")} href="/surfaces/cards" is_active={@current_path == "/surfaces/cards"} />
        <.sidebar_item label={gettext("Tabs")} icon={sidebar_icon("tabs")} href="/surfaces/tabs" is_active={@current_path == "/surfaces/tabs"} />
        <.sidebar_item label={gettext("Modals")} icon={sidebar_icon("modals")} href="/surfaces/modals" is_active={@current_path == "/surfaces/modals"} />
        <.sidebar_item label={gettext("Modal Dialogs")} icon={sidebar_icon("modal_dialogs")} href="/surfaces/modal-dialogs" is_active={@current_path == "/surfaces/modal-dialogs"} />
        <.sidebar_item label={gettext("Detail Panel")} icon={sidebar_icon("detail_panel")} href="/surfaces/detail-panel" is_active={@current_path == "/surfaces/detail-panel"} />
        <.sidebar_item label={gettext("Splitter")} icon={sidebar_icon("splitter")} href="/surfaces/splitter" is_active={@current_path == "/surfaces/splitter"} />
      </.sidebar_submenu>

      <%!-- ========================= Data display ======================= --%>
      <.sidebar_submenu id="data-display" label={gettext("Data display")} icon={sidebar_icon("data_display_group")} is_open={@current_path in ["/data-display/lists", "/data-display/document", "/data-display/sheet", "/data-display/code", "/data-display", "/data-display/data-display-2", "/data-display/stats"] or String.starts_with?(@current_path, "/tables")}>
        <.sidebar_item label={gettext("Lists")} icon={sidebar_icon("lists")} href="/data-display/lists" is_active={@current_path == "/data-display/lists"} />
        <.sidebar_item label={gettext("Document")} icon={sidebar_icon("document")} href="/data-display/document" is_active={@current_path == "/data-display/document"} />
        <.sidebar_item label={gettext("Sheet (Invoice)")} icon={sidebar_icon("sheet")} href="/data-display/sheet" is_active={@current_path == "/data-display/sheet"} />
        <.sidebar_item label={gettext("Code")} icon={sidebar_icon("code")} href="/data-display/code" is_active={@current_path == "/data-display/code"} />
        <.sidebar_item label={gettext("Data Display")} icon={sidebar_icon("data_display")} href="/data-display" is_active={@current_path == "/data-display"} />
        <.sidebar_item label={gettext("Data Display v2")} icon={sidebar_icon("data_display_2")} href="/data-display/data-display-2" is_active={@current_path == "/data-display/data-display-2"} />
        <.sidebar_item label={gettext("Stats")} icon={sidebar_icon("stats")} href="/data-display/stats" is_active={@current_path == "/data-display/stats"} />

        <.sidebar_submenu id="tables" label={gettext("Tables")} icon={sidebar_icon("table")} is_open={String.starts_with?(@current_path, "/tables")}>
          <.sidebar_item label={gettext("Standard Tables")} icon={sidebar_icon("table")} href="/tables/standard" is_active={@current_path == "/tables/standard"} />
          <.sidebar_item label={gettext("Table Sizing")} icon={sidebar_icon("sizing")} href="/tables/sizing" is_active={@current_path == "/tables/sizing"} />
          <.sidebar_item label={gettext("Responsive")} icon={sidebar_icon("table_responsive")} href="/tables/responsive" is_active={@current_path == "/tables/responsive"} />
          <.sidebar_item label={gettext("Filters")} icon={sidebar_icon("table_filters")} href="/tables/filters" is_active={@current_path == "/tables/filters"} />
          <.sidebar_item label={gettext("Multi-Select")} icon={sidebar_icon("table_multiselect")} href="/tables/multi-select" is_active={@current_path == "/tables/multi-select"} />
          <.sidebar_item label={gettext("Comparison")} icon={sidebar_icon("table_comparison")} href="/tables/comparison" is_active={@current_path == "/tables/comparison"} />
        </.sidebar_submenu>
      </.sidebar_submenu>

      <%!-- ====================== Data visualization ==================== --%>
      <.sidebar_submenu id="data-viz" label={gettext("Data visualization")} icon={sidebar_icon("data_viz_group")} is_open={@current_path == "/data-viz" or String.starts_with?(@current_path, "/kpi")}>
        <.sidebar_item label={gettext("Data Visualization")} icon={sidebar_icon("data_visualization")} href="/data-viz" is_active={@current_path == "/data-viz"} />

        <.sidebar_submenu id="kpi" label={gettext("KPI")} icon={sidebar_icon("kpi")} is_open={String.starts_with?(@current_path, "/kpi")}>
          <.sidebar_item label={gettext("Combined dashboard")} icon={sidebar_icon("dashboard")} href="/kpi/dashboard" is_active={@current_path == "/kpi/dashboard"} />
          <.sidebar_item label={gettext("Terminal grid")} icon={sidebar_icon("kpi_terminal")} href="/kpi/terminal-grid" is_active={@current_path == "/kpi/terminal-grid"} />
          <.sidebar_item label={gettext("Sparkline list")} icon={sidebar_icon("kpi_sparkline")} href="/kpi/sparkline-list" is_active={@current_path == "/kpi/sparkline-list"} />
          <.sidebar_item label={gettext("Comparison gauges")} icon={sidebar_icon("kpi")} href="/kpi/comparison-gauges" is_active={@current_path == "/kpi/comparison-gauges"} />
          <.sidebar_item label={gettext("Hero + supporting")} icon={sidebar_icon("cards")} href="/kpi/hero-supporting" is_active={@current_path == "/kpi/hero-supporting"} />
          <.sidebar_item label={gettext("Bento layout")} icon={sidebar_icon("grid")} href="/kpi/bento" is_active={@current_path == "/kpi/bento"} />
          <.sidebar_item label={gettext("Numeric strip")} icon={sidebar_icon("kpi_numeric")} href="/kpi/numeric-strip" is_active={@current_path == "/kpi/numeric-strip"} />
          <.sidebar_item label={gettext("Editorial minimal")} icon={sidebar_icon("kpi_editorial")} href="/kpi/editorial-minimal" is_active={@current_path == "/kpi/editorial-minimal"} />
        </.sidebar_submenu>
      </.sidebar_submenu>

      <%!-- ========================== Feedback ========================== --%>
      <.sidebar_submenu id="feedback" label={gettext("Feedback")} icon={sidebar_icon("feedback")} is_open={@current_path in ["/feedback/alerts", "/feedback/callouts", "/feedback/toasts", "/feedback/notifications", "/feedback/tooltips", "/feedback/loaders"] or String.starts_with?(@current_path, "/timeline")}>
        <.sidebar_item label={gettext("Alerts")} icon={sidebar_icon("alerts")} href="/feedback/alerts" is_active={@current_path == "/feedback/alerts"} />
        <.sidebar_item label={gettext("Callouts")} icon={sidebar_icon("callouts")} href="/feedback/callouts" is_active={@current_path == "/feedback/callouts"} />
        <.sidebar_item label={gettext("Toasts")} icon={sidebar_icon("toasts")} href="/feedback/toasts" is_active={@current_path == "/feedback/toasts"} />
        <.sidebar_item label={gettext("Notifications")} icon={sidebar_icon("notifications")} href="/feedback/notifications" is_active={@current_path == "/feedback/notifications"} />
        <.sidebar_item label={gettext("Tooltips")} icon={sidebar_icon("tooltips")} href="/feedback/tooltips" is_active={@current_path == "/feedback/tooltips"} />
        <.sidebar_item label={gettext("Loaders")} icon={sidebar_icon("loaders")} href="/feedback/loaders" is_active={@current_path == "/feedback/loaders"} />

        <.sidebar_submenu id="timeline" label={gettext("Timeline")} icon={sidebar_icon("timeline")} is_open={String.starts_with?(@current_path, "/timeline")}>
          <.sidebar_item label={gettext("Simple")} icon={sidebar_icon("timeline_simple")} href="/timeline/simple" is_active={@current_path == "/timeline/simple"} />
          <.sidebar_item label={gettext("Block")} icon={sidebar_icon("timeline_block")} href="/timeline/block" is_active={@current_path == "/timeline/block"} />
          <.sidebar_item label={gettext("Feed")} icon={sidebar_icon("timeline_feed")} href="/timeline/feed" is_active={@current_path == "/timeline/feed"} />
          <.sidebar_item label={gettext("Advanced")} icon={sidebar_icon("timeline")} href="/timeline/advanced" is_active={@current_path == "/timeline/advanced"} />
        </.sidebar_submenu>
      </.sidebar_submenu>

      <%!-- ===================== Interactive & misc ===================== --%>
      <.sidebar_submenu id="interactive" label={gettext("Interactive & misc")} icon={sidebar_icon("interactive")} is_open={@current_path in ["/interactive/badges", "/interactive/command-palette"]}>
        <.sidebar_item label={gettext("Badges")} icon={sidebar_icon("badges")} href="/interactive/badges" is_active={@current_path == "/interactive/badges"} />
        <.sidebar_item label={gettext("Command Palette")} icon={sidebar_icon("command_palette")} href="/interactive/command-palette" is_active={@current_path == "/interactive/command-palette"} />
      </.sidebar_submenu>

      <%!-- ======================= Virtual Scroll ====================== --%>
      <.sidebar_submenu id="virtual-scroll" label={gettext("Virtual Scroll")} icon={sidebar_icon("virtual_scroll")} is_open={String.starts_with?(@current_path, "/virtual-scroll")}>
        <.sidebar_item label={gettext("Demo")} icon={sidebar_icon("vs_demo")} href="/virtual-scroll/demo" is_active={@current_path == "/virtual-scroll/demo"} />
      </.sidebar_submenu>
    </.sidebar>

    <.layout_content>
      <.main>
        <.flash_group flash={@flash} />
        {@inner_content}
      </.main>

      <.footer />
    </.layout_content>
  </.layout_inner>
</.layout>

<.profile_panel id="profile-panel" name="John Doe" email="john.doe@company.com" role="Administrator">
  <:tabs>
    <div class="pa-tabs pa-tabs--full">
      <button class="pa-tabs__item pa-tabs__item--active" data-profile-tab="profile">
        <span class="pa-icon pa-icon--user" aria-hidden="true"></span>
        <span class="pa-profile-panel__tab-text">{gettext("Profile")}</span>
      </button>
      <button class="pa-tabs__item" data-profile-tab="favorites">
        <span class="pa-icon pa-icon--favorites" aria-hidden="true"></span>
        <span class="pa-profile-panel__tab-text">{gettext("Favorites")}</span>
      </button>
    </div>
  </:tabs>

  <div class="pa-tabs__panel pa-tabs__panel--active" data-profile-panel="profile">
    <nav class="pa-profile-panel__nav">
      <ul>
        <.profile_nav_item href="#" icon={sidebar_icon("user")}>{gettext("Profile Settings")}</.profile_nav_item>
        <.profile_nav_item href="#" icon={sidebar_icon("security")}>{gettext("Security")}</.profile_nav_item>
        <.profile_nav_item href="#" icon={sidebar_icon("notifications")}>{gettext("Notifications")}</.profile_nav_item>
        <.profile_nav_item href="#" icon={sidebar_icon("preferences")}>{gettext("Preferences")}</.profile_nav_item>
        <.profile_nav_item href="#" icon={sidebar_icon("help")}>
          {gettext("Help & Support")}
        </.profile_nav_item>
      </ul>
    </nav>
  </div>

  <div class="pa-tabs__panel" data-profile-panel="favorites">
    <div class="pa-profile-panel__favorites">
      <ul>
        <li>
          <div class="pa-profile-panel__favorite-item" data-href="/">
            <span class="pa-profile-panel__favorite-icon"><%= Phoenix.HTML.raw(sidebar_icon("dashboard")) %></span>
            <span class="pa-profile-panel__favorite-label">{gettext("Dashboard")}</span>
            <button class="pa-profile-panel__favorite-remove" title={gettext("Remove from favorites")}>
              <span class="pa-icon pa-icon--x" aria-hidden="true"></span>
            </button>
          </div>
        </li>
        <li>
          <div class="pa-profile-panel__favorite-item" data-href="/forms">
            <span class="pa-profile-panel__favorite-icon"><%= Phoenix.HTML.raw(sidebar_icon("forms")) %></span>
            <span class="pa-profile-panel__favorite-label">{gettext("Forms")}</span>
            <button class="pa-profile-panel__favorite-remove" title={gettext("Remove from favorites")}>
              <span class="pa-icon pa-icon--x" aria-hidden="true"></span>
            </button>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <:footer_>
    <button class="pa-btn pa-btn--secondary pa-btn--block">
      {gettext("Switch Account")}
    </button>
    <button class="pa-btn pa-btn--danger pa-btn--block">
      {gettext("Sign Out")}
    </button>
  </:footer_>
</.profile_panel>

<.settings_panel default_theme="audi" />

<.toast_container id="toasts" position="top-end" is_hook />

<%!-- Global command palette. Mounted once in the layout so Ctrl+K / ⌘K and the
      navbar/sidebar search triggers (show_command_palette/0) work on every page.
      The reusable state machine lives in PureAdmin.CommandPalette; the demo's
      commands/contexts/search/actions come from DemoWeb.CommandPaletteSource. --%>
<.live_component
  module={PureAdmin.CommandPalette}
  id="command-palette"
  source={DemoWeb.CommandPaletteSource}
/>

<%!-- Global server-driven dialog host. Mounted once so any LiveView can open a
      dialog from the server via PureAdmin.Dialog.{confirm,info,…} / close/1; the
      :pa_dialog assign + auto-close come from the {PureAdmin.Dialog, :default}
      on_mount hook in the router's live_session. --%>
<PureAdmin.Dialog.host dialog={@pa_dialog} />
