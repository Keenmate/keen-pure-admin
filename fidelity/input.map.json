{
  "component": "input",
  "features": {
    "size":        { "prop": "size",   "kind": "enum", "values": ["xs", "sm", "lg", "xl"] },
    "state":       { "prop": "validation", "kind": "enum", "values": ["success", "warning", "error"] },
    "themeColor":  { "prop": "color",  "kind": "enum", "values": ["1","2","3","4","5","6","7","8","9"], "nativeType": "string" },
    "type":        { "prop": "type",   "kind": "enum", "values": ["text","email","password","tel","url","search"] },
    "placeholder": { "prop": "placeholder", "kind": "string", "channel": "rest" },
    "value":       { "prop": "value",  "kind": "string" },
    "name":        { "prop": "name",   "kind": "string" },
    "id":          { "prop": "id",     "kind": "string" },
    "disabled":    { "prop": "disabled", "kind": "bool", "channel": "rest" },
    "readonly":    { "prop": "readonly", "kind": "bool", "channel": "rest" },
    "required":    { "prop": "required", "kind": "bool", "channel": "rest" },
    "extraClass":  { "prop": "class",  "kind": "string" }
  }
}
